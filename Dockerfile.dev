# Local development image. The production image lives in Dockerfile and is
# built/deployed by Kamal; this one just needs to run `bin/rails server`
# with dev/test gems available against the `db` service in docker-compose.yml.
ARG RUBY_VERSION=3.4.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# chromium: headless browser for system tests (test/application_system_test_case.rb,
# capybara + selenium-webdriver, added in #18) -- selenium-webdriver's Selenium
# Manager auto-resolves a matching chromedriver against whatever's on PATH.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev pkg-config chromium && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Match the host user (uid/gid 1000) so files written into the bind-mounted
# source (Gemfile.lock, generated code, logs) aren't owned by root on the host.
ARG UID=1000
ARG GID=1000
RUN groupadd -g $GID rails && useradd -u $UID -g $GID -m rails

WORKDIR /rails
RUN chown rails:rails /rails
USER rails

ENV BUNDLE_PATH=/usr/local/bundle

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
