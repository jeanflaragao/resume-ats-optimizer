# Copy this file to .env and fill in real values. .env is gitignored (see
# .gitignore's "/.env*" rule) and read automatically by `docker compose` at
# the project root, which passes these through to the web container per
# docker-compose.yml's `environment:` block. Never commit real secrets here
# or in docker-compose.yml itself.

# Anthropic API key used by the RubyLLM gem (config/initializers/ruby_llm.rb)
# for requirement extraction, bullet rewriting, and resume import via LLM.
ANTHROPIC_API_KEY=

# Safety guard (app/services/llm_call_guard.rb) against accidental real API
# usage during local/manual testing. Leave ENABLE_REAL_LLM_CALLS unset/false
# to get labeled stub responses instead of real Claude calls; set it to true
# (with ANTHROPIC_API_KEY present) to deliberately opt in for a session.
# MAX_LLM_CALLS_PER_DAY caps real calls once enabled — the whole service's
# shared daily ceiling. MAX_LLM_CALLS_PER_DAY_PER_SUBJECT (issue #106,
# ADR-0039) bounds how much of that shared ceiling any one signed-in account
# can draw on its own, so exhausting the cap needs many accounts rather than
# one — must not exceed MAX_LLM_CALLS_PER_DAY.
ENABLE_REAL_LLM_CALLS=false
MAX_LLM_CALLS_PER_DAY=10
MAX_LLM_CALLS_PER_DAY_PER_SUBJECT=10

# Per-subject daily quotas (app/services/usage/quota.rb, issue #22). A separate
# and narrower guard than MAX_LLM_CALLS_PER_DAY above: that one is the whole
# service's ceiling for a day, these stop one browser session from eating it.
# The values below are the local defaults, restated so they are visible; leave
# them unset locally and you get exactly these.
#
# Note "browser session", not "person": there is no auth yet, so the subject is
# ApplicationController#current_owner_token and an incognito window gets a fresh
# quota (ADR-0023).
RATE_LIMIT_RESUME_EXTRACTION_PER_DAY=5
RATE_LIMIT_REQUIREMENT_EXTRACTION_PER_DAY=25
RATE_LIMIT_BULLET_REWRITING_PER_DAY=15
RATE_LIMIT_PDF_GENERATION_PER_DAY=15

# Google OAuth (issue #120, ADR-0032, config/initializers/omniauth.rb). No
# local default — sign-in fails at the Google handshake until you register
# your own OAuth 2.0 Client (Web application type) in Google Cloud Console
# with http://localhost:3000/auth/google_oauth2/callback as an authorized
# redirect URI, and put its id/secret here. See docs/railway-deploy-runbook.md
# for the production counterpart of this step.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe Checkout for credit packs and the unlimited window (issue #123,
# config/initializers/{payments_config_guard,stripe}.rb). No local default,
# same reason as Google OAuth above — checkout fails at the Stripe API call
# until you set your own test-mode secret key and create the three Prices in
# your own Stripe account. STRIPE_WEBHOOK_SECRET comes from `stripe listen`
# when testing locally (see docs/railway-deploy-runbook.md), not from the
# dashboard's webhook endpoint secret, which is a different value scoped to a
# registered HTTPS endpoint you don't have in local dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_5_CREDITS=
STRIPE_PRICE_ID_15_CREDITS=
STRIPE_PRICE_ID_UNLIMITED_30_DAYS=

# ---------------------------------------------------------------------------
# Production (issue #48's deploy config) — none of the values below default.
#
# The defaults above exist for local safety only. In production the app
# REFUSES TO BOOT unless all of these are set explicitly (ADR-0020,
# LlmCallGuard.validate_configuration!). Deliberately no numbers here for
# production: the cap is a spend decision made at deploy time, not in code.
#
#   ANTHROPIC_API_KEY       required whenever ENABLE_REAL_LLM_CALLS=true.
#   ENABLE_REAL_LLM_CALLS   must be set. No default.
#   MAX_LLM_CALLS_PER_DAY   must be set, to a positive integer. No default.
#                           Required even in stub mode, so that turning stub
#                           mode off is a one-variable change.
#   MAX_LLM_CALLS_PER_DAY_PER_SUBJECT
#                           must be set, to a positive integer no larger than
#                           MAX_LLM_CALLS_PER_DAY (issue #106, ADR-0039). No
#                           default in production for the same reason: the
#                           size of a "fair share" is a policy decision made
#                           at deploy time, not a value to invent in code.
#   ALLOW_STUB_LLM=true     the ONLY way to run stub mode outside development.
#                           Without it, ENABLE_REAL_LLM_CALLS=false is a boot
#                           failure rather than a mode, because stub mode ships
#                           placeholder text into real users' resumes. When set,
#                           every page carries a "Demo mode" banner.
#
#   RATE_LIMIT_RESUME_EXTRACTION_PER_DAY
#   RATE_LIMIT_REQUIREMENT_EXTRACTION_PER_DAY
#   RATE_LIMIT_BULLET_REWRITING_PER_DAY
#   RATE_LIMIT_PDF_GENERATION_PER_DAY
#                           all four must be set, to positive integers. No
#                           defaults (ADR-0023, same rule and same reason as
#                           MAX_LLM_CALLS_PER_DAY). Size them from counts
#                           observed AFTER issue #82 — #45 records that earlier
#                           daily figures under-report by roughly the average
#                           experience count, so a quota derived from them
#                           starts from bad data. A quota set too low throttles
#                           real users off a working product and reports
#                           nothing; there is no safe placeholder.
#
#   GOOGLE_OAUTH_CLIENT_ID
#   GOOGLE_OAUTH_CLIENT_SECRET
#                           both must be set (ADR-0032,
#                           Authentication::ConfigGuard.validate_configuration!).
#                           Without them every visitor fails to sign in, and
#                           since accounts are mandatory (issue #120), the app
#                           is unusable rather than degraded. Set on both the
#                           web and worker services — the boot check runs in
#                           every process that boots the app.
#
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_PRICE_ID_5_CREDITS
#   STRIPE_PRICE_ID_15_CREDITS
#   STRIPE_PRICE_ID_UNLIMITED_30_DAYS
#                           all five must be set (issue #123,
#                           Payments::ConfigGuard.validate_configuration!).
#                           Without STRIPE_SECRET_KEY/the three Price ids,
#                           every "Buy credits" click fails at the Stripe API
#                           call; without STRIPE_WEBHOOK_SECRET, a webhook
#                           request can never be verified, so a real payment
#                           would arrive with no way to grant it. See
#                           docs/railway-deploy-runbook.md for creating the
#                           Stripe account, the three Products/Prices, and
#                           registering the production webhook endpoint.
#
# Sizing MAX_LLM_CALLS_PER_DAY: one full user flow (upload + analyze + preview
# + download) costs 2 + E real provider requests, where E is the number of
# experiences with bullets — 7 for a 5-experience resume, 11 for a 9-experience
# one, hard-bounded at 2 + 20 = 22 since issue #130/ADR-0038 capped E at
# Resume::Import::MAX_EXPERIENCES. It was 2 + 2E until issue #83: the download
# now reuses the preview's rewrites (ADR-0021) instead of running the fan-out a
# second time, except on a cache miss (an edited job description, or more than
# CACHE_TTL after the preview), which still costs 2 + 2E, hard-bounded at 42.
# Budget MAX_LLM_CALLS_PER_DAY for roughly (expected daily users) x (2 + 2E).
#
# Sizing MAX_LLM_CALLS_PER_DAY_PER_SUBJECT (issue #106, ADR-0039): the 42
# request worst-case-per-flow figure above is a hard floor — anything smaller
# makes even one legitimate worst-case flow impossible. How many multiples of
# that one account should get per day, and how that trades off against
# MAX_LLM_CALLS_PER_DAY, is a deploy-time policy decision this file
# deliberately does not make for you.
# ---------------------------------------------------------------------------
