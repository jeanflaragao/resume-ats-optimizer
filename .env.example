# Copy this file to .env and fill in real values. .env is gitignored (see
# .gitignore's "/.env*" rule) and read automatically by `docker compose` at
# the project root, which passes these through to the web container per
# docker-compose.yml's `environment:` block. Never commit real secrets here
# or in docker-compose.yml itself.

# Anthropic API key used by the RubyLLM gem (config/initializers/ruby_llm.rb)
# for requirement extraction, bullet rewriting, and resume import via LLM.
ANTHROPIC_API_KEY=

# Safety guard (app/services/llm_call_guard.rb) against accidental real API
# usage during local/manual testing. Leave ENABLE_REAL_LLM_CALLS unset/false
# to get labeled stub responses instead of real Claude calls; set it to true
# (with ANTHROPIC_API_KEY present) to deliberately opt in for a session.
# MAX_LLM_CALLS_PER_DAY caps real calls once enabled — a blunt, process-wide
# stopgap ahead of issue #22's per-user rate limiting.
ENABLE_REAL_LLM_CALLS=false
MAX_LLM_CALLS_PER_DAY=10

# ---------------------------------------------------------------------------
# Production (issue #48's deploy config) — none of the values below default.
#
# The defaults above exist for local safety only. In production the app
# REFUSES TO BOOT unless all of these are set explicitly (ADR-0020,
# LlmCallGuard.validate_configuration!). Deliberately no numbers here for
# production: the cap is a spend decision made at deploy time, not in code.
#
#   ANTHROPIC_API_KEY       required whenever ENABLE_REAL_LLM_CALLS=true.
#   ENABLE_REAL_LLM_CALLS   must be set. No default.
#   MAX_LLM_CALLS_PER_DAY   must be set, to a positive integer. No default.
#                           Required even in stub mode, so that turning stub
#                           mode off is a one-variable change.
#   ALLOW_STUB_LLM=true     the ONLY way to run stub mode outside development.
#                           Without it, ENABLE_REAL_LLM_CALLS=false is a boot
#                           failure rather than a mode, because stub mode ships
#                           placeholder text into real users' resumes. When set,
#                           every page carries a "Demo mode" banner.
#
# Sizing MAX_LLM_CALLS_PER_DAY: one full user flow (upload + analyze + preview
# + download) costs 2 + E real provider requests, where E is the number of
# experiences with bullets — 7 for a 5-experience resume, 11 for a 9-experience
# one. It was 2 + 2E until issue #83: the download now reuses the preview's
# rewrites (ADR-0021) instead of running the fan-out a second time. Budget the
# worst case rather than the typical one if you like — a download that misses
# the cache (an edited job description, or more than 15 minutes after the
# preview) still costs 2 + 2E. The counter is global with no per-user dimension
# (#45), so budget roughly (expected daily users) x (2 + 2E) until #22 lands.
# ---------------------------------------------------------------------------
