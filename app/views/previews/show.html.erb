<div class="max-w-xl mx-auto w-full">
  <h1 class="text-2xl font-semibold mb-4">Optimized resume preview</h1>

  <% if @optimized_resume.name.present? || @optimized_resume.email.present? || @optimized_resume.phone.present? %>
    <p class="text-gray-800 font-medium"><%= @optimized_resume.name %></p>
    <p class="text-gray-600 mb-4">
      <%= [ @optimized_resume.email, @optimized_resume.phone ].select(&:present?).join(" | ") %>
    </p>
  <% end %>

  <% if @optimized_resume.summary.present? %>
    <h2 class="text-lg font-semibold mt-6 mb-2">Summary</h2>
    <p class="text-gray-700"><%= @optimized_resume.summary %></p>
  <% end %>

  <% if @optimized_resume.experiences.present? %>
    <h2 class="text-lg font-semibold mt-6 mb-2">Experience</h2>
    <% @optimized_resume.experiences.each do |experience| %>
      <div class="mb-4">
        <p class="font-medium">
          <%= [ experience.title, experience.company ].select(&:present?).join(", ") %>
        </p>
        <% if experience.starts_on.present? || experience.ends_on.present? %>
          <% starts_text = experience.starts_on&.strftime("%b %Y") %>
          <% ends_text = experience.ends_on ? experience.ends_on.strftime("%b %Y") : "Present" %>
          <% date_text = [ starts_text, ends_text ].compact.join(" - ") %>
        <% end %>
        <p class="text-sm text-gray-500">
          <%= [ experience.location, date_text ].select(&:present?).join(" | ") %>
        </p>
        <ul class="list-disc list-inside text-gray-700">
          <% Array(experience.bullets).select(&:present?).each do |bullet| %>
            <li><%= bullet %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>

  <% if @optimized_resume.educations.present? %>
    <h2 class="text-lg font-semibold mt-6 mb-2">Education</h2>
    <% @optimized_resume.educations.each do |education| %>
      <div class="mb-4">
        <p class="font-medium"><%= education.school %></p>
        <% detail = [ education.degree, education.field_of_study ].select(&:present?).join(", ") %>
        <% if education.starts_on.present? || education.ends_on.present? %>
          <% starts_text = education.starts_on&.strftime("%b %Y") %>
          <% ends_text = education.ends_on ? education.ends_on.strftime("%b %Y") : "Present" %>
          <% date_text = [ starts_text, ends_text ].compact.join(" - ") %>
        <% end %>
        <p class="text-sm text-gray-500">
          <%= [ detail, date_text ].select(&:present?).join(" | ") %>
        </p>
      </div>
    <% end %>
  <% end %>

  <% if Array(@optimized_resume.skills).any?(&:present?) %>
    <h2 class="text-lg font-semibold mt-6 mb-2">Skills</h2>
    <p class="text-gray-700"><%= Array(@optimized_resume.skills).select(&:present?).join(", ") %></p>
  <% end %>

  <%# data: { turbo: false } is a stopgap -- see issue #47. %>
  <%= form_with url: resume_downloads_path(@resume), method: :post, data: { turbo: false }, class: "mt-8" do |form| %>
    <%= form.hidden_field :job_description_text, value: @job_description_text %>
    <%= form.submit "Download PDF", class: "bg-blue-600 text-white rounded px-4 py-2 cursor-pointer" %>
  <% end %>
</div>
