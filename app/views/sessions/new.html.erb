<div class="max-w-xl mx-auto w-full text-center">
  <h1 class="text-2xl font-semibold mb-4">Sign in to resume-ats-optimizer</h1>
  <p class="text-gray-600 mb-6">
    An account is required — every upload runs a real analysis, and we need somewhere to keep
    your resumes and credits.
  </p>

  <%# turbo: false is deliberate: this redirects the whole browser to Google's own domain, which
      has no turbo_stream equivalent to convert to (unlike ADR-0010's cases, later fixed by
      ADR-0014). %>
  <%= button_to "Continue with Google", "/auth/google_oauth2",
        data: { turbo: false },
        class: "bg-blue-600 text-white rounded px-4 py-2 cursor-pointer mx-auto" %>
</div>
