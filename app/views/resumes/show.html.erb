<div class="max-w-xl mx-auto w-full">
  <h1 class="text-2xl font-semibold mb-4">Resume uploaded</h1>
  <p class="text-gray-800 font-medium mb-2"><%= @resume.name.presence || "Untitled resume" %></p>
  <p class="text-gray-600 mb-6">
    Parsed <%= pluralize(@resume.experiences.size, "work experience") %> and
    <%= pluralize(@resume.educations.size, "education entry", "education entries") %>.
  </p>

  <h2 class="text-lg font-semibold mb-2">Check against a job description</h2>
  <p class="text-gray-600 mb-4">
    Paste a job posting below to see how this resume matches it.
  </p>

  <%# The "Preview optimized resume" form below still carries data: { turbo: false } -- a
      stopgap tracked by issue #47, not yet converted to a turbo_stream response (this
      "Check match" form above was, in #47's first controller conversion).

      Two separate forms (not one form with a formaction-overridden second button) because
      Rails' per-form CSRF tokens bind a form's authenticity_token to its own declared action
      -- a formaction override submits to a different path than the token was generated for,
      which fails CSRF verification on a real (non-Turbo) POST. This was a real, pre-existing
      bug from #17, only found via manual browser testing in #18 since the test env disables
      forgery protection entirely (config/environments/test.rb). The sync Stimulus controller
      keeps the second form's hidden field mirroring the visible textarea. This split is kept
      for both forms even after #47's turbo_stream conversion, since it's still required for
      the format.html fallback (real non-Turbo POSTs -- JS-disabled browsers, integration
      tests), which #47 does not remove. %>
  <div data-controller="sync">
    <%= form_with url: resume_job_description_path(@resume), method: :post,
          class: "flex flex-col gap-4 mb-4" do |form| %>
      <%= form.text_area :job_description_text, value: @job_description_text, rows: 10, required: true,
            class: "border rounded p-2", data: { sync_target: "source", action: "input->sync#sync" } %>
      <%= form.submit "Check match", class: "bg-blue-600 text-white rounded px-4 py-2 self-start cursor-pointer" %>
    <% end %>

    <%= form_with url: resume_preview_path(@resume), method: :post, data: { turbo: false }, class: "mb-8" do |form| %>
      <%= form.hidden_field :job_description_text, data: { sync_target: "target" } %>
      <%= form.submit "Preview optimized resume", class: "bg-gray-700 text-white rounded px-4 py-2 cursor-pointer" %>
    <% end %>
  </div>

  <% if @comparison %>
    <div class="border-t pt-6 mb-8">
      <h2 class="text-lg font-semibold mb-2">Match results</h2>

      <% if @match_score %>
        <p class="text-2xl font-semibold mb-4"><%= @match_score %>% match</p>
      <% else %>
        <p class="text-gray-500 mb-4">
          Not enough required/preferred skills or keywords were found in the job description to
          calculate a score.
        </p>
      <% end %>

      <div class="flex flex-col gap-4">
        <div>
          <h3 class="font-medium">Required skills</h3>
          <p class="text-sm text-gray-600">
            Matched: <%= @comparison.matched_required_skills.join(", ").presence || "none" %>
          </p>
          <p class="text-sm text-gray-600">
            Missing: <%= @comparison.missing_required_skills.join(", ").presence || "none" %>
          </p>
        </div>
        <div>
          <h3 class="font-medium">Preferred skills</h3>
          <p class="text-sm text-gray-600">
            Matched: <%= @comparison.matched_preferred_skills.join(", ").presence || "none" %>
          </p>
          <p class="text-sm text-gray-600">
            Missing: <%= @comparison.missing_preferred_skills.join(", ").presence || "none" %>
          </p>
        </div>
        <div>
          <h3 class="font-medium">Keywords</h3>
          <p class="text-sm text-gray-600">
            Matched: <%= @comparison.matched_keywords.join(", ").presence || "none" %>
          </p>
          <p class="text-sm text-gray-600">
            Missing: <%= @comparison.missing_keywords.join(", ").presence || "none" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>
