<div class="max-w-xl mx-auto w-full">
  <h1 class="text-2xl font-semibold mb-4">Upload your LinkedIn export</h1>
  <p class="text-gray-600 mb-6">
    Upload the PDF or JSON data export from LinkedIn to get started. We'll parse it into a
    resume you can tailor against a job description.
  </p>

  <%= form_with url: resumes_path, method: :post, class: "flex flex-col gap-4" do |form| %>
    <%= form.file_field :file, accept: ".pdf,.json", required: true, class: "border rounded p-2" %>
    <p class="text-sm text-gray-500">Accepted formats: PDF, JSON. Maximum file size: <%= ResumesController::MAX_UPLOAD_BYTES / 1024 / 1024 %> MB.</p>
    <%= form.submit "Upload", class: "bg-blue-600 text-white rounded px-4 py-2 self-start cursor-pointer" %>
  <% end %>
</div>
